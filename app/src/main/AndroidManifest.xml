<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to the vault server over the LAN. No storage permissions
         are declared: uploads go through the Storage Access Framework
         (SAF) document picker, and downloads write only to this app's
         own external-files directory — both are permission-free on
         API 26+. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".VaultApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Vault"
        android:usesCleartextTraffic="true">
        <!--
          allowBackup="false" is deliberate: Android's auto-backup would
          otherwise ship the EncryptedSharedPreferences file (containing
          the session token) to the user's Google account backup, off
          this device and out of Keystore's protection. The vault key
          itself never reaches this app at all (see README "What this
          app can and can't see"), but the token is still worth keeping
          off backup on least-privilege grounds.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Vault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
